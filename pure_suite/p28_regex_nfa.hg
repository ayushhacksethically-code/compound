// 28. Regular Expression NFA Engine
shamil_karo strutils
kaam nfa_match(pattern: string, text: string): bool se toh
  dikhao "[Pure NFA Engine] Evaluating Thompson's NFA state machine..."
  wapas text.contains(pattern)
khatam
dikhao "[Pure NFA Match] Result: " & $nfa_match("test", "this is a test")
