// 8. Circular Ring-Buffer Logger
rakho buffer: array[4, int]
rakho head = 0

kaam log_event(event_id: int) se toh
  buffer[head mod 4] = event_id
  dikhao "[Pure RingBuffer] Logged Event ID #" & $event_id & " at slot " & $(head mod 4)
  head += 1
khatam

log_event(101)
log_event(102)
log_event(103)
log_event(104)
log_event(105)
