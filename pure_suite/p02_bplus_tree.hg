// 2. B+ Tree Disk Indexer
shamil_karo algorithm

kaam btree_search(keys: seq[int], target: int): int se toh
  dikhao "[Pure B+ Tree] Binary searching page keys " & $keys & " for key " & $target
  wapas keys.binarySearch(target)
khatam

rakho keys: seq[int] = @[10, 20, 30, 40, 50, 60]
dikhao "[Pure B+ Tree Page] Offset index: " & $btree_search(keys, 40)
