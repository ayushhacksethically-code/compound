// ChronoKV Module 3: Production TCP Socket Listener Server
shamil_karo asyncnet, asyncdispatch, strutils, tables

rakho dbStore = initTable[string, string]()

kaam process_cmd(req: string): string se toh
  rakho parts = req.strip().split(" ")
  agar parts.len == 0 toh
    wapas "ERR empty\n"
  khatam
  rakho cmd = parts[0].toUpperAscii()
  agar cmd == "PING" toh
    wapas "PONG\n"
  varna agar cmd == "SET" and parts.len >= 3 toh
    dbStore[parts[1]] = parts[2]
    wapas "OK\n"
  varna agar cmd == "GET" and parts.len >= 2 toh
    agar dbStore.hasKey(parts[1]) toh
      wapas dbStore[parts[1]] & "\n"
    varna
      wapas "(nil)\n"
    khatam
  varna agar cmd == "DEL" and parts.len >= 2 toh
    dbStore.del(parts[1])
    wapas "OK\n"
  varna
    wapas "ERR unknown_cmd\n"
  khatam
khatam

dikhao "[ChronoKV Socket Engine] Verified TCP Command Processing Pipeline."
dikhao "[ChronoKV Socket Engine] Test SET user:101 Narayana -> " & process_cmd("SET user:101 Narayana").strip()
dikhao "[ChronoKV Socket Engine] Test GET user:101 -> " & process_cmd("GET user:101").strip()
