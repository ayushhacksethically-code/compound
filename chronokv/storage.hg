// ChronoKV Module 1: Production LSM-Tree Engine (MemTable + Multi-SSTable Disk Scanner)
shamil_karo tables, os, strutils

rakho memTable = initTable[string, string]()
rakho memThreshold = 500
rakho sstCount = 0

kaam storage_flush_sstable() se toh
  sstCount += 1
  rakho sstFile = "/tmp/chronokv_sst_" & $sstCount & ".dat"
  
  rakho content = ""
  har k, v mein memTable se toh
    content.add(k & "=" & v & "\n")
  khatam
  
  writeFile(sstFile, content)
  memTable.clear()
khatam

kaam storage_put(key: string, val: string) se toh
  memTable[key] = val
  agar memTable.len >= memThreshold toh
    storage_flush_sstable()
  khatam
khatam

kaam storage_get(key: string): string se toh
  // 1. Check RAM MemTable first
  agar memTable.hasKey(key) toh
    wapas memTable[key]
  khatam

  // 2. Scan flushed SSTable disk files in reverse chronological order (newest to oldest)
  har i mein countdown(sstCount, 1) se toh
    rakho sstFile = "/tmp/chronokv_sst_" & $i & ".dat"
    agar fileExists(sstFile) toh
      rakho lines = readFile(sstFile).splitLines()
      har line mein lines se toh
        agar "=" in line toh
          rakho parts = line.split("=")
          agar parts[0] == key toh
            wapas parts[1]
          khatam
        khatam
      khatam
    khatam
  khatam

  wapas "(nil)"
khatam

// Test SSTable Disk Recovery
storage_put("persist_key", "Real_Disk_Data_Narayana")
storage_flush_sstable()
dikhao "[SSTable Read Test] Querying 'persist_key' after MemTable Clear -> " & storage_get("persist_key")
