# Exclude all generated Nim files EXCEPT the core compiler source files
*.nim
!compound.nim
!english.nim
!hinglish.nim
!generate_nesting.nim

# Exclude generated JavaScript output files
*.js
!docs/**/*.js

# Exclude intermediate binaries (without extensions)
/compound
/demo
/demo_en
/fib
/calc
/constants_test
/deep_nesting_test
/error_leak_test
/error_test
/full_test
/matrix_audit
/matrix_final_audit
/module_b
/op_test
/rigid_token_test
/simple_en
/subprocess_suite
/test_nim
/mini_os_kernel
/mini_relational_sql_db
/datasaver_144p_logic
/ps_test
/smalltest
/audit_*
/benchmark_*
/workload_*

# Exclude temporary test directories
test_app/
test_eg_app/

# Exclude suite binaries
suite/p*
!suite/p*.hg
!suite/p*.eg

pure_suite/p*
!pure_suite/p*.hg
!pure_suite/p*.eg

interactive_suite/i*
!interactive_suite/i*.hg
!interactive_suite/i*.eg

suite_storage/s*
!suite_storage/s*.hg
!suite_storage/s*.eg

chronokv/bench
chronokv/main
chronokv/raft
chronokv/server
chronokv/storage

# Logs & temp artifacts
*.log
/tmp/*
docs/public/
docs/resources/
.vscode/
*.vsix
