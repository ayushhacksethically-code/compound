// Phase 1 Test 1.2: Deep Recursion & Dynamic Array Growth Benchmark

kaam fibonacci(n: int): int toh
    agar n <= 1 toh
        wapas n
    varna
        wapas fibonacci(n - 1) + fibonacci(n - 2)
    khatam
khatam

dikhao "Fibonacci(25) recursive test:", fibonacci(25)

rakho numbers = newSeq[int]()
rakho i = 1
jabtak i <= 1000000 toh
    numbers.add(i)
    i += 1
khatam

dikhao "Dynamic Array million elements length:", numbers.len
