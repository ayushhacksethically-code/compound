{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Hinglish Compound",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#shell"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.hinglish",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.hinglish",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.hinglish",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.hinglish",
          "match": "\\\\."
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.hinglish",
          "match": "\\b(agar|varna agar|varna|toh|jabtak|har|mein|khatam|bas|chuno|jab|wapas|aage_bhadho|jaari_rakho|roko|tod_do|koshish_karo|galti_pakdo|aakhir_mein|shart_jaanch)\\b"
        },
        {
          "name": "keyword.declaration.hinglish",
          "match": "\\b(rakho|pukka|banao|kaam|shamil_karo|import_karo|c_ka_kaam)\\b"
        },
        {
          "name": "keyword.operator.logical.hinglish",
          "match": "\\b(aur|ya|nahi)\\b"
        },
        {
          "name": "support.function.builtin.hinglish",
          "match": "\\b(dikhao|pucho|chalao|galti_phenko|bahar_niklo|band_karo)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.hinglish",
          "match": "\\b(sahi|galat)\\b"
        },
        {
          "name": "constant.language.null.hinglish",
          "match": "\\b(khali)\\b"
        },
        {
          "name": "constant.numeric.hinglish",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.hinglish",
          "match": "(?<=kaam\\s+)[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "shell": {
      "patterns": [
        {
          "name": "keyword.other.shell.hinglish",
          "match": "^\\s*\\$\\s.*$"
        }
      ]
    }
  },
  "scopeName": "source.hinglish"
}
