// Point 3 Test: Cyclic Reference Handling Benchmark

banao Node = ref object
    val: int
    next: Node
khatam

kaam testCycle() toh
    rakho a = Node(val: 1)
    rakho b = Node(val: 2)
    a.next = b
    b.next = a
khatam

dikhao "Starting 10,000 cyclic object allocations..."
rakho i = 1
jabtak i <= 10000 toh
    testCycle()
    i += 1
khatam

dikhao "10,000 cyclic reference pairs allocated and deallocated cleanly by ORC!"
