// Workload 1: Async Non-Blocking HTTP Client/Server & Connection Pool System

shamil_karo std/asyncdispatch
shamil_karo std/asyncnet

kaam handleClient(client: AsyncSocket) {.async.} =
    koshish_karo toh
        rakho req = await client.recvLine()
        await client.send("HTTP/1.1 200 OK\r\nContent-Length: 13\r\n\r\nHello Client!\n")
    galti_pakdo toh
        dikhao "Socket error handled gracefully"
    aakhir_mein toh
        client.close()
    khatam
khatam

kaam startServer() {.async.} =
    rakho server = newAsyncSocket()
    server.bindAddr(Port(8989))
    server.listen()
    dikhao "[Server] Async HTTP Server listening on port 8989..."
    
    rakho count = 0
    jabtak count < 10 toh
        rakho client = await server.accept()
        asyncCheck handleClient(client)
        count += 1
    khatam
    server.close()
khatam

kaam fireClient(id: int): Future[void] {.async.} =
    koshish_karo toh
        rakho socket = newAsyncSocket()
        await socket.connect("127.0.0.1", Port(8989))
        await socket.send("GET / HTTP/1.1\r\n\r\n")
        rakho res = await socket.recvLine()
        dikhao "[Client", id, "] Received Response:", res
        socket.close()
    galti_pakdo toh
        dikhao "[Client", id, "] Error connecting"
    khatam
khatam

kaam runPool() {.async.} =
    asyncCheck startServer()
    await sleepAsync(100) # Give server time to bind

    rakho clientFutures = newSeq[Future[void]]()
    rakho i = 1
    jabtak i <= 10 toh
        clientFutures.add(fireClient(i))
        i += 1
    khatam

    await all(clientFutures)
    dikhao "[Workload 1 PASSED] All 10 Async Client Connections handled cleanly!"
khatam

waitFor(runPool())
