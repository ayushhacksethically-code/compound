// Workload 3: Producer-Consumer Pipeline with Generators & Closures

iterator eventProducer(): int =
    rakho i = 1
    jabtak i <= 100000 toh
        yield i
        i += 1
    khatam
khatam

rakho filterEven = proc(val: int): bool = val mod 2 == 0
rakho mapSquare = proc(val: int): int = val * 2

rakho totalEvents = 0
rakho sumAccumulator = 0

har event mein eventProducer() toh
    if filterEven(event) toh
        rakho transformed = mapSquare(event)
        sumAccumulator += transformed
        totalEvents += 1
    khatam
khatam

dikhao "[Producer] Total Events Processed:", totalEvents
dikhao "[Consumer Pipeline] Final Metrics Accumulator Sum:", sumAccumulator
dikhao "[Workload 3 PASSED] 100,000 Event Pipeline with Iterators & Closures executed with 0 memory accumulation!"
