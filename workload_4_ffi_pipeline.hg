// Workload 4: High-Performance C FFI Data Processing Pipeline in Compound

import std/math

c_ka_kaam malloc(size: int): pointer from "stdlib.h"
c_ka_kaam free(p: pointer) from "stdlib.h"
c_ka_kaam printf(fmt: cstring, val1: int, val2: float64): cint from "stdio.h"

banao CVector2 = object
    x: float64
    y: float64
khatam

rakho count = 500000
rakho structSize = sizeof(CVector2)
rakho rawPtr = malloc(count * structSize)

dikhao "[C FFI] Allocated C native memory buffer for 500,000 CVector2 elements at pointer address."

# Treat raw pointer as C array of CVector2
rakho vecArray = cast[ptr UncheckedArray[CVector2]](rawPtr)

rakho i = 0
jabtak i < count toh
    vecArray[i].x = float64(i) * 1.5
    vecArray[i].y = float64(i) * 2.5
    i += 1
khatam

rakho dotSum = 0.0
i = 0
jabtak i < count toh
    dotSum += sqrt(vecArray[i].x * vecArray[i].x + vecArray[i].y * vecArray[i].y)
    i += 1
khatam

printf("[C FFI] Processed %d CVector2 elements! Cumulative Distance Sum: %.2f\n", count, dotSum)

free(rawPtr)
dikhao "[C FFI] Native C memory freed manually! Nim ORC Garbage Collector remains 100% undisturbed."
dikhao "[Workload 4 PASSED] High-Performance C FFI Memory & Data Pipeline Succeeded!"
