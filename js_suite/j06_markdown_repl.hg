// 6. Interactive Markdown & Compound AST Live Parser (Web REPL)
shamil_karo std/strutils

banao ASTNode = object
  kind: string
  content: string
khatam

kaam parseMarkdownHeader(line: string): ASTNode toh
  let s = line.strip()
  agar s.startsWith("# ") toh
    wapas ASTNode(kind: "H1", content: s.substr(2))
  varna agar s.startsWith("## ") toh
    wapas ASTNode(kind: "H2", content: s.substr(3))
  varna toh
    wapas ASTNode(kind: "Paragraph", content: s)
  khatam
khatam

rakho node1 = parseMarkdownHeader("# Compound Web REPL Engine")
rakho node2 = parseMarkdownHeader("## AST Lexical Tokenizer")

dikhao "[6/10 PASSED] Live AST Parser - Node 1:", node1.kind, "->", node1.content
dikhao "[6/10 PASSED] Live AST Parser - Node 2:", node2.kind, "->", node2.content
