// Phase 4 Test 4.1: Self-Hosting Lexer Written in Compound Hinglish!

banao Token = object
    kind: string
    val: string
khatam

kaam tokenizeCompound(src: string): seq[Token] toh
    rakho tokens = newSeq[Token]()
    rakho i = 0
    rakho n = src.len

    jabtak i < n toh
        rakho ch = src[i]
        if ch == ' ' or ch == '\t' or ch == '\n' toh
            i += 1
            continue
        khatam

        if ch == '+' or ch == '-' or ch == '*' or ch == '=' toh
            rakho opStr = "" & ch
            tokens.add(Token(kind: "OPERATOR", val: opStr))
            i += 1
            continue
        khatam

        if ch >= '0' and ch <= '9' toh
            rakho numStr = ""
            jabtak i < n and src[i] >= '0' and src[i] <= '9' toh
                numStr.add(src[i])
                i += 1
            khatam
            tokens.add(Token(kind: "NUMBER", val: numStr))
            continue
        khatam

        if (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or ch == '_' toh
            rakho identStr = ""
            jabtak i < n and ((src[i] >= 'a' and src[i] <= 'z') or (src[i] >= 'A' and src[i] <= 'Z') or src[i] == '_' or (src[i] >= '0' and src[i] <= '9')) toh
                identStr.add(src[i])
                i += 1
            khatam
            tokens.add(Token(kind: "IDENTIFIER", val: identStr))
            continue
        khatam

        i += 1
    khatam

    wapas tokens
khatam

rakho testCode = "rakho ginti = 100 + 200"
dikhao "Input Source Code:", testCode

rakho resultTokens = tokenizeCompound(testCode)

dikhao "=== Tokens Generated by Compound Self-Hosted Lexer ==="
har tok mein resultTokens toh
    dikhao "Token Kind:", tok.kind, "-> Value:", tok.val
khatam
