// Compound Language Demo (Hinglish - .hg)
rakho naam = "Narayana"
dikhao "Namaste " & naam & "! Welcome to Compound Language."

rakho a = 10
rakho b = 20

agar a < b toh
  dikhao "a (" & $a & ") b se chhota hai."
khatam

kaam jodo(x: int, y: int): int se toh
  wapas x + y
khatam

dikhao "10 + 20 = " & $jodo(a, b)
