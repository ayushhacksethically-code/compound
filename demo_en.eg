// Compound Language Demo (Plain English - .eg)
keep name = "Narayana"
show "Hello " & name & "! Welcome to Compound Language."

keep a = 10
keep b = 20

if a < b do
  show "a is smaller than b"
end

task add_numbers(x: int, y: int): int do
  return x + y
end

show "10 + 20 = " & $add_numbers(a, b)
