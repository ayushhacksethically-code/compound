// Phase 5 Test 5.1: 100,000 Recursive Tree & Memory Mutation Test

banao Node = object
    val: int
    leftVal: int
    rightVal: int
khatam

kaam buildTree(depth: int): int toh
    agar depth <= 0 toh
        wapas 1
    varna
        rakho n = Node(val: depth, leftVal: depth - 1, rightVal: depth - 1)
        wapas buildTree(n.leftVal) + buildTree(n.rightVal)
    khatam
khatam

dikhao "Starting 100,000 Recursive Tree Operations with ASan..."
rakho total = 0
rakho i = 1
jabtak i <= 100000 toh
    total += buildTree(5)
    i += 1
khatam

dikhao "Finished 100,000 Tree Operations safely. Total:", total
