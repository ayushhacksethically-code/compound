// Project 29: Bandwidth & Network Interface Monitor
kaam monitor_interface(iface: string) se toh
  dikhao "Reading bandwidth stats for interface: " & iface
  chalao "grep " & iface & " /proc/net/dev | awk '{print \"[Net] RX Bytes:\", $2, \"| TX Bytes:\", $10}' || echo '[Net Monitor] Interface inactive'"
khatam

monitor_interface("eth0")
monitor_interface("wlan0")
monitor_interface("lo")
