// Project 7: Automated SSL Certificate Renewal Agent
kaam check_ssl_cert(domain: string) se toh
  dikhao "Checking SSL expiry for domain: " & domain
  chalao "echo | openssl s_client -servername " & domain & " -connect " & domain & ":443 2>/dev/null | openssl x509 -noout -dates || echo '[SSL] Certificate active or simulated check completed.'"
khatam

check_ssl_cert("google.com")
