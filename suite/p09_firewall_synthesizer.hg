// Project 9: Firewall Rule Synthesizer
kaam apply_rule(port: int, action: string) se toh
  dikhao "Applying firewall rule for port " & $port & " (" & action & ")"
  chalao "echo '[iptables] -A INPUT -p tcp --dport " & $port & " -j " & action & "'"
khatam

apply_rule(80, "ACCEPT")
apply_rule(443, "ACCEPT")
apply_rule(22, "ACCEPT")
